<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand_navy">#0B1220</color>
    <color name="brand_blue">#2E6BFF</color>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_navy</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/brand_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorPrimary">@color/brand_blue</item>
        <item name="android:colorAccent">@color/brand_blue</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
